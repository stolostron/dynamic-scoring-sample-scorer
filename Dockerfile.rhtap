FROM registry.redhat.io/openshift/golang-builder:golang-builder-v1.26-rhel9 AS builder

WORKDIR /workspace

COPY go.mod ./
COPY cmd ./cmd
COPY internal ./internal
COPY LICENSE LICENSE

RUN CGO_ENABLED=1 GOEXPERIMENT=strictfipsruntime go build -mod=readonly -trimpath -ldflags="-s -w" -o sample-scorer ./cmd/sample-scorer

FROM registry.redhat.io/ubi9/ubi-minimal-pqc:latest

LABEL url="https://github.com/stolostron/dynamic-scoring-framework-sample-scorer" \
      com.redhat.component="dynamic-scoring-framework-sample-scorer" \
      summary="Dynamic Scoring Framework sample scorer for Red Hat Advanced Cluster Management" \
      description="Dynamic Scoring Framework sample scorer for Red Hat Advanced Cluster Management" \
      io.k8s.display-name="Dynamic Scoring Framework Sample Scorer" \
      io.k8s.description="Dynamic Scoring Framework Sample Scorer for Red Hat Advanced Cluster Management" \
      io.openshift.tags="acm dynamic-scoring-framework-sample-scorer"

WORKDIR /
COPY --from=builder /workspace/sample-scorer /sample-scorer
COPY --from=builder /workspace/LICENSE /licenses/

EXPOSE 8000

USER 65532:65532

ENTRYPOINT ["/sample-scorer"]
